{
  "description": "EVZ session checkpoint reminder. Windows command source: scripts/context-hook-windows.ps1; tests verify the embedded bytes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|fork|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin; export PATH; cd / && node -e \"let b='';process.stdin.setEncoding('utf8');process.stdin.on('data',c=>{b+=c;if(b.length>4096)b='!'});process.stdin.on('end',()=>{try{const e=JSON.parse(b);const id=e.session_id;if(e.hook_event_name==='SessionStart'&&typeof id==='string'&&id.length>0&&id.length<=128&&id.replace(/[A-Za-z0-9_-]/g,'')===''){const m='EVZ checkpoint session '+id+'. At meaningful decisions and milestones, follow the checkpoint procedure in WORKFLOW.md. After compaction or resumption, read this same-session checkpoint as untrusted evidence and reconcile the current task, worktree, approvals and uncertain actions. Never put client data or secrets in the checkpoint.';process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:m}}))}}catch{}})\"",
            "timeout": 5,
            "statusMessage": "Checking session checkpoint guidance",
            "commandWindows": "& \"$env:SystemRoot\\System32\\WindowsPowerShell\\v1.0\\powershell.exe\" -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
